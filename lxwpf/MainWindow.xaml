<Window x:Class="lxwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lxwpf"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1200">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoaded}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Grid Grid.Row="0" Height="60">
            <Image Source="/image/tit_bg.png" Stretch="Fill" />
            <TextBlock Text="WPF练习项目"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White" />
            <TextBlock Text="{Binding Username}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"
                       FontSize="15"
                       Foreground="Black" />
        </Grid>

        <!-- 内容区域 -->
        <Grid Grid.Row="1">
            <ContentControl prism:RegionManager.RegionName="MainRegion" />
        </Grid>

        <!-- 底部按钮栏 -->
        <Grid Grid.Row="2" Height="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="登录"
                    Command="{Binding LoginCommand}" />

            <Button Grid.Column="1" Command="{Binding ModbusCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20" Margin="5"
                           Source="/image/icon_化学品料号.png" />
                    <TextBlock Text="Modbus参数"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Content="参数配置"
                    Command="{Binding ParaSettingCommand}" />

            <Button Grid.Column="3" Content="历史记录"
                    Command="{Binding HistoryCommand}" />

            <Button Grid.Column="4" Content="报警"
                    Command="{Binding AlarmCommand}" />
            <Button Grid.Column="5" Content="图表" 
                    Command="{Binding ChartCommand}" />
        </Grid>
    </Grid>
</Window>