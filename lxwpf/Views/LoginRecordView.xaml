<UserControl x:Class="lxwpf.Views.LoginRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:lxwpf.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:share="clr-namespace:lxwpf.Share"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoaded}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding PageUnLoaded}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid>
            <Grid.Background>
                <ImageBrush/>
            </Grid.Background>
            <Grid>
                <Grid.Background>
                    <ImageBrush ImageSource="/image/bjt.jpg"/>
                </Grid.Background>
            </Grid>
            <Border BorderBrush="#FF2B93F3"                 
                    Width="480"
                    Height="400"
                    Margin="0,0,100,0"
                    Padding="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    BorderThickness="1.5">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="25">
                        <ComboBox ItemsSource="{Binding Users}"
                            SelectedItem="{Binding UserName}"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="25">
                        <PasswordBox share:PasswordHelper.Attach="True"
             share:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <!--<Grid Grid.Row="2" Margin="25">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="登录" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Content="注册" VerticalAlignment="Center" />
                        </Grid>-->
                    <StackPanel Grid.Row="2" Margin="25">
                        <Button Content="登录" Command="{Binding LoginCommand}"/>
                        <Button Content="注册" Command="{Binding RegisterCommand}"/>
                    </StackPanel>
                    <TextBlock 
                        Grid.Row="3"
                        Foreground="Red"
                        Text="{Binding ErrorMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
